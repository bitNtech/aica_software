# Copy to .env and fill in. .env and secrets/ are git-ignored — never commit them.

# Firebase Admin: path to the service-account JSON (relative to backend/).
FIREBASE_CREDENTIALS=secrets/service-account.json
# Firebase web API key (Project settings → General). Used server-side only,
# for the Auth REST API (password sign-in, Google sign-in, email action codes).
FIREBASE_WEB_API_KEY=
# Firestore database ID. This project has only (default), in asia-south1.
FIRESTORE_DATABASE=(default)

# Resend (https://resend.com) for verification, reset, invite and review emails.
RESEND_API_KEY=
# Must be on a domain verified in Resend. onboarding@resend.dev only delivers
# to the Resend account owner's own address — fine for a first local test.
EMAIL_FROM=AICA <onboarding@resend.dev>

# Google sign-in: the OAuth web client Firebase created
# (Firebase console → Authentication → Sign-in method → Google → Web SDK configuration).
# Add  http://localhost:5173/api/auth/google/callback  as an authorised redirect URI
# on that client in Google Cloud console → APIs & Services → Credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Where the console runs. Links in emails and redirects point here.
APP_URL=http://localhost:5173
# Origins allowed to make state-changing requests (comma-separated).
ALLOWED_ORIGINS=http://localhost:5173
# true behind HTTPS. Must be true in production.
COOKIE_SECURE=false

ACT_AS_MINUTES=30