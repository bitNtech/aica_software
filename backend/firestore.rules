rules_version = '2';
// Only the AICA backend reads and writes Firestore, through the Admin SDK,
// which bypasses these rules. Nothing else — no browser, no client SDK — may
// touch the database. Paste this into Firebase console → Firestore Database → Rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
