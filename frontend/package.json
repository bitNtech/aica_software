{
  "name": "aica-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "VITE_CONSOLE_MODE=live VITE_CONSOLE_LIVE=team,settings,activity,requests,calls,callbacks,appointments,handoffs,reports,numbers,tools,knowledge,uploads,agents,live vite",
    "dev:demo": "VITE_AUTH_MODE=demo VITE_CONSOLE_MODE=demo vite",
    "api": "cd ../backend && .venv/bin/uvicorn app.main:app --port 8000 --reload",
    "build": "tsc -b && vite build && vite build --ssr src/landing/entry-server.tsx --outDir dist-ssr && node scripts/prerender-landing.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^7.18.3"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^30.1.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
