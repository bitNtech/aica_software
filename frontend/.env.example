# Frontend build-time configuration. Vite inlines VITE_* values into the
# bundle, so never put a secret here. Copy to .env.local for local overrides.

# The backend's public origin when it is deployed on its own host, no trailing
# slash, e.g. https://api.aica.bitntech.in. Must share a site with this
# frontend (both under aica.bitntech.in) so the SameSite=Lax session cookie is
# sent. Leave empty locally: `npm run dev` proxies /api to 127.0.0.1:8000.
VITE_API_URL=

# Landing page: URL that accepts a demo request as a JSON POST. Empty: the
# form hands the request to WhatsApp instead.
VITE_DEMO_ENDPOINT=

# "demo" runs the console against an in-browser mock (npm run dev:demo).
VITE_AUTH_MODE=
